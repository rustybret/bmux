# Standing conflict classes for bmux fork sync
# Format: <action>: <glob>
#
# keep-deleted: files removed in this fork that upstream might re-introduce
# take-theirs: regenerable files where upstream's version is always preferred

# Upstream CLA Assistant workflow (requires workflow PAT scope not held by automated sync bot)
keep-deleted: .github/workflows/cla.yml
keep-deleted: .github/workflows/cla-policy-guard.yml

# Upstream cmux skill contract workflow (requires workflow PAT scope not held by automated sync bot)
keep-deleted: .github/workflows/cmux-skill-contract.yml
# fork-sync-exclusions for bmux
# Entries prefixed with keep-deleted: ensure deleted upstream paths remain deleted on sync.
# Entries prefixed with take-theirs: ensure regenerable bundles take upstream version on conflict.

